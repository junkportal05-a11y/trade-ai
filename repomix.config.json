{
  "output": {
    "filePath": "codebase.md",
    "style": "markdown",
    "headerText": "ApexTrade Security-Hardened Codebase Export",
    "showLineNumbers": true
  },
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "**/.git/**",
      "**/.claude/**",
      "**/.reticle/**",
      "**/.obsidian*/**",
      "**/.pytest_cache/**",
      "**/caveman/**",
      "**/.shardmind/**",
      "**/thinking/**",
      "**/logs/**",
      "**/gsd-core/**",
      "**/.env*",
      "**/.secret_*",
      "**/settings.local.json",
      "**/*.log",
      "**/*.lock",
      "**/*.swp",
      "**/*.patch",
      "**/*.diff",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/node_modules/**",
      "**/scratch/**",
      "**/work/**",
      "**/trade_ai_scratch/**",
      "**/historical_data/**",
      "**/*.csv",
      "**/*.jsonl",
      "**/*.parquet",
      "**/angelone_instruments.json",
      "**/claude-obsidian/**",
      "**/attachments/**",
      "**/graphify-out/**",
      "codebase.txt",
      "codebase.md"
    ]
  }
}