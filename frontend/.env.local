# VITE_API_URL and VITE_WS_URL are intentionally left empty for production.
# The Vercel rewrites in vercel.json proxy /api and /ws to the HF Space backend.
# These variables must NOT be set to a non-empty value in production, or the
# pre-build check script will fail (see scripts/check-env.cjs).
#
# For local development, use .env (not .env.local) or set these in the
# Vercel dashboard environment variables.
#
# VITE_API_URL=
# VITE_WS_URL=