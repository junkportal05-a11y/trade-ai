{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://apextrade-core-trade-ai-backend.hf.space/api/$1" }
  ],
  "redirects": [
    { "source": "/(.*)", "destination": "/index.html", "status": 200, "log": 404 }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://trade-ai-beta.vercel.app" },
        { "key": "Access-Control-Allow-Methods", "value": "POST" },
        { "key": "Access-Control-Allow-Headers", "value": "content-type" },
        { "key": "Access-Control-Max-Age", "value": "600" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self' https://apextrade-core-trade-ai-backend.hf.space; frame-src 'none'" }
      ]
    }
  ]
}